---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection, type CollectionEntry } from "astro:content"
import Quote from "../components/Quote.astro"
import FullscreenWorkSlider from "../components/FullscreenWorkSlider.tsx"
import JournalList from "../components/JournalList.astro"

type WorkEntry = CollectionEntry<"works">
type ExhibitionEntry = CollectionEntry<"exhibitions">

const works: WorkEntry[] = (await getCollection("works")).sort(
  (a: WorkEntry, b: WorkEntry) => (a.data.order ?? 0) - (b.data.order ?? 0)
)

const exhibitions: ExhibitionEntry[] = await getCollection("exhibitions")

const sliderItems = works
  .filter(w => !!w.data.cover)
  .map(w => ({
    id: w.slug,
    title: w.data.title,
    image: w.data.cover,
    href: `/works/${w.slug}`,
  }))
---

<BaseLayout title="Atelier Buelens">
  <!-- HERO (kept) -->
  <section
    id="home"
    class="relative h-screen flex items-center justify-center text-center bg-cover bg-center bg-no-repeat"
    style="background-image: url('/works/ramp-coffee/01.jpg');"
  >
    <div class="absolute inset-0 bg-black/30"></div>
    <h1 class="relative z-10 text-lg md:text-3xl font-light text-white">Minimal furniture, built with precision.</h1>
  </section>

  <!-- WORKS: slider only -->
  <section id="works" class="scroll-mt-24">
    {
      sliderItems.length > 0 ? (
        <FullscreenWorkSlider client:load items={sliderItems} autoMs={4000} />
      ) : (
        <div class="mx-auto max-w-6xl px-6 py-24">
          <p class="opacity-60">Works coming soon.</p>
        </div>
      )
    }
  </section>

  <!-- ABOUT -->
  <section id="about" class="mx-auto max-w-6xl px-6 pt-28 pb-20 scroll-mt-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <img
        src="/about/portrait.jpg"
        alt="Portrait"
        class="w-full h-auto object-cover"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="leading-relaxed mb-6">
          My work combines craftsmanship with my background as an engineer. It begins with a pure geometric form;
          materials are brought together in a way that balances aesthetics and functionality. Sketches, strength
          calculations, and simulations are part of the process. During production, I oversee the woodwork, while the
          steelwork is outsourced.
        </p>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <Quote />

  <!-- EXHIBITIONS -->
  <section id="exhibitions" class="mx-auto max-w-3xl px-6 pt-28 pb-16 scroll-mt-24">
    <h2 class="text-xl mb-4">Exhibitions</h2>

    {
      exhibitions.length > 0 ? (
        <ul class="space-y-2">
          {exhibitions.map(({ data }: { data: ExhibitionEntry["data"] }) => (
            <li class="flex items-baseline justify-between border-b py-3">
              <div>
                <p>{data.title}</p>
                <p class="text-sm opacity-80">
                  {data.venue}
                  {data.city ? `, ${data.city}` : ""}
                </p>
              </div>
              <div class="text-sm">
                {new Date(data.start).toLocaleDateString()}
                {data.end ? ` – ${new Date(data.end).toLocaleDateString()}` : ""}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="opacity-60">Exhibitions coming soon.</p>
      )
    }
  </section>

  <JournalList />

  <!-- CONTACT (centered, no title) -->
  <section
    id="contact"
    class="flex flex-col items-center justify-center text-center py-32 border-t border-black/10 scroll-mt-24"
  >
    <div class="space-y-2 text-base md:text-lg leading-relaxed">
      <p>
        <a
          href="mailto:info@atelierbuelens.com"
          class="underline underline-offset-4 transition-opacity hover:opacity-60"
        >
          info@atelierbuelens.com
        </a>
      </p>
      <p>+32 47 837 18 88</p>
      <p>Azalealaan 37<br />1030&nbsp;Brussel</p>
    </div>
  </section>
</BaseLayout>
