---
import { sanityClient } from "../../utils/sanityClient"
import { urlFor } from "../../utils/sanityImage"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { toHTML } from "@portabletext/to-html"

const { slug } = Astro.params

const entry = await sanityClient.fetch(
  `
  *[_type == "journal" && slug.current == $slug][0]{
    title,
    date,
    cover,
    content
  }
`,
  { slug }
)

function formatDate(d: string | number | Date) {
  const date = new Date(d)
  return date.toLocaleDateString("en-GB")
}
---

<BaseLayout title={entry.title}>
  <section class="mx-auto max-w-3xl px-6 pt-28 pb-20">
    <h1 class="text-2xl mb-3">{entry.title}</h1>
    <p class="text-sm opacity-70 mb-6">{formatDate(entry.date)}</p>

    {
      entry.cover && (
        <img src={urlFor(entry.cover).width(1600).url()} alt={entry.title} class="w-full h-auto object-cover mb-8" />
      )
    }

    <article class="prose prose-neutral" set:html={toHTML(entry.content)} />
  </section>
</BaseLayout>
