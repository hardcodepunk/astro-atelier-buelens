---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { sanityClient } from "../../utils/sanityClient"
import { urlFor } from "../../utils/sanityImage"
import { toHTML } from "@portabletext/to-html"

// Build-time: tell Astro which slugs to generate
export async function getStaticPaths() {
  const entries = await sanityClient.fetch(`
    *[_type == "journal" && defined(slug.current)]{
      "slug": slug.current
    }
  `)

  return entries.map((entry: { slug: string }) => ({
    params: { slug: entry.slug },
  }))
}

const { slug } = Astro.params

const entry = await sanityClient.fetch(
  `
  *[_type == "journal" && slug.current == $slug][0]{
    title,
    date,
    cover,
    content
  }
`,
  { slug }
)

function formatDate(d: string | number | Date) {
  const date = new Date(d)
  const day = String(date.getDate()).padStart(2, "0")
  const month = String(date.getMonth() + 1).padStart(2, "0")
  const year = date.getFullYear()
  return `${day}.${month}.${year}`
}
---

<BaseLayout title={entry?.title ?? "Journal"}>
  <section class="mx-auto max-w-3xl px-6 pt-28 pb-20">
    <h1 class="text-2xl mb-3">{entry.title}</h1>
    {entry?.date && <p class="text-sm opacity-70 mb-6">{formatDate(entry.date)}</p>}

    {
      entry?.cover && (
        <img src={urlFor(entry.cover).width(1600).url()} alt={entry.title} class="w-full h-auto object-cover mb-8" />
      )
    }

    {entry?.content && <article class="prose prose-neutral" set:html={toHTML(entry.content)} />}
  </section>
</BaseLayout>
