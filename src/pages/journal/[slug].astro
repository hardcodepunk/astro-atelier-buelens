---
import BaseLayout from "../../layouts/BaseLayout.astro"
import JournalList from "../../components/JournalList.astro"
import { getCollection, type CollectionEntry } from "astro:content"

type JournalEntry = CollectionEntry<"journal">

export async function getStaticPaths() {
  const journal = await getCollection("journal")
  return journal.map(({ slug }) => ({
    params: { slug },
  }))
}

const { slug } = Astro.params
if (!slug) throw new Error("Missing slug param")

// Safer filtering by slug (avoids deprecated getEntryBySlug)
const matches = await getCollection("journal", entry => entry.slug === slug)
const post = matches[0] as JournalEntry | undefined
if (!post) throw new Error(`Post not found: ${slug}`)

const { data } = post
const { Content } = await post.render()

const formattedDate = new Date(data.date).toLocaleDateString("nl-BE", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<BaseLayout title={`${data.title} – Atelier Buelens`}>
  <article class="mx-auto max-w-3xl px-6 pt-28 pb-24">
    {
      data.cover && (
        <img src={data.cover} alt={data.title} class="w-full rounded-2xl mb-8" loading="eager" decoding="async" />
      )
    }
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight">{data.title}</h1>
    <p class="text-sm opacity-70 mt-2 mb-10">{formattedDate}</p>
    <div class="prose prose-lg max-w-none leading-relaxed">
      <Content />
    </div>
  </article>

  <!-- Show related posts (excluding the current one) -->
  <JournalList excludeSlug={slug} />
</BaseLayout>
