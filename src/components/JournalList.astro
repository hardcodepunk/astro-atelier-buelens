---
import { sanityClient } from "../utils/sanityClient"
import { urlFor } from "../utils/sanityImage"

const entries = await sanityClient.fetch(`
  *[_type == "journal"] | order(date desc) {
    title,
    slug,
    date,
    cover,
    content
  }
`)

function formatDate(d: string | number | Date) {
  const date = new Date(d)
  const day = String(date.getDate()).padStart(2, "0")
  const month = String(date.getMonth() + 1).padStart(2, "0")
  const year = date.getFullYear()
  return `${day}.${month}.${year}`
}
---

<section id="journal" class="mx-auto max-w-6xl px-6 pt-28 pb-20">
  <h2 class="text-xl mb-6">Journal</h2>

  {
    entries.length > 0 ? (
      <ul class="space-y-8">
        {entries.map((entry: { slug: { current: any }; cover: any; title: unknown; date: any }) => (
          <li class="flex flex-col gap-2">
            <a href={`/journal/${entry.slug.current}`} class="group">
              {entry.cover && (
                <img
                  src={urlFor(entry.cover).width(1200).url()}
                  alt={entry.title}
                  class="w-full h-auto object-cover mb-4"
                />
              )}
              <h3 class="text-lg font-light group-hover:opacity-60 transition">{entry.title}</h3>
            </a>
            <p class="text-sm opacity-70">{formatDate(entry.date)}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="opacity-60">Journal entries coming soon.</p>
    )
  }
</section>
