---
import { sanityClient } from "../utils/sanityClient"

interface QuoteDoc {
  text: string
  author?: string
}

const quote = await sanityClient.fetch<QuoteDoc | null>(`
  *[_type == "quote"][0]{
    text,
    author
  }
`)

const text = quote?.text || "I want to explore the boundary between tension and calm, between strength and elegance."

const author = quote?.author || ""
---

<section class="flex items-center justify-center bg-white text-black px-6 py-40">
  <blockquote class="max-w-3xl text-center leading-tight">
    <p class="text-2xl md:text-4xl font-light tracking-tight">
      “{text}”
    </p>

    {author && <footer class="mt-4 text-sm opacity-60">{author}</footer>}
  </blockquote>
</section>
