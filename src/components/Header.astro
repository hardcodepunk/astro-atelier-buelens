---
const nav = [
  { href: "/", label: "Home" },
  { href: "/works", label: "Works" },
  { href: "/about", label: "About" },
  { href: "/exhibitions", label: "Exhibitions" },
  { href: "/contact", label: "Contact" },
]
---

<header class="fixed top-0 left-0 right-0 bg-white/80 backdrop-blur z-50">
  <div class="mx-auto max-w-6xl px-6 py-5 flex justify-between items-center">
    <a href="/" class="font-medium tracking-wide">Atelier Buelens</a>
    <nav class="space-x-6 text-sm">
      {
        nav.map(item => (
          <a href={item.href} class="hover:opacity-60">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
