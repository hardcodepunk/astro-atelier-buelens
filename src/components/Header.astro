---
const nav = [
  { href: "/#works", label: "Works" },
  { href: "/#about", label: "About" },
  { href: "/#exhibitions", label: "Exhibitions" },
  { href: "/#contact", label: "Contact" },
]

const isHome = Astro.url.pathname === "/"
---

<header
  id="site-header"
  data-home={isHome ? "true" : "false"}
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
    isHome ? "text-white" : "bg-white text-black header-solid"
  }`}
>
  <div class="mx-auto max-w-6xl px-6 py-6 flex items-center justify-between relative">
    <a href="/" class="block">
      <img
        src="/logo.svg"
        alt="Atelier Buelens"
        class="header-logo h-7 w-auto md:h-9 object-contain"
        loading="lazy"
        decoding="async"
      />
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-light tracking-wide">
      {
        nav.map(item => (
          <a href={item.href} class="hover:opacity-60 transition-opacity">
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden relative z-50 w-6 h-5 flex flex-col justify-between focus:outline-none"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar block w-6 h-0.5 transition-all duration-300 origin-center"></span>
      <span class="bar block w-6 h-0.5 transition-all duration-300 origin-center"></span>
      <span class="bar block w-6 h-0.5 transition-all duration-300 origin-center"></span>
    </button>

    <div
      id="mobile-menu"
      class="fixed inset-0 h-screen z-40 flex flex-col items-center justify-center gap-10
        text-2xl font-light tracking-wide bg-white text-black
        opacity-0 pointer-events-none transition-opacity duration-300"
    >
      {
        nav.map(item => (
          <a href={item.href} class="hover:opacity-60 transition-opacity">
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("site-header")
    const isHomeHeader = header && header.dataset.home === "true"

    if (isHomeHeader && header) {
      let last = window.scrollY

      const setTop = () => {
        header.classList.remove("header-solid", "bg-white", "text-black")
        header.classList.add("text-white")
        header.style.transform = "translateY(0)"
      }

      const setSolid = () => {
        header.classList.add("header-solid", "bg-white", "text-black")
        header.classList.remove("text-white")
        header.style.transform = "translateY(0)"
      }

      if (window.scrollY <= 0) {
        setTop()
      } else {
        setSolid()
      }

      window.addEventListener("scroll", () => {
        const y = window.scrollY

        if (y <= 0) {
          setTop()
        } else if (y > last) {
          header.style.transform = "translateY(-100%)"
        } else {
          setSolid()
        }

        last = y
      })
    }

    const btn = document.getElementById("menu-toggle")
    const menu = document.getElementById("mobile-menu")
    if (!btn || !menu) return

    const openMenu = () => {
      btn.classList.add("open")
      btn.setAttribute("aria-expanded", "true")
      menu.classList.remove("opacity-0", "pointer-events-none")
      menu.classList.add("opacity-100", "pointer-events-auto")
      document.documentElement.classList.add("overflow-hidden")
    }

    const closeMenu = () => {
      btn.classList.remove("open")
      btn.setAttribute("aria-expanded", "false")
      menu.classList.remove("opacity-100", "pointer-events-auto")
      menu.classList.add("opacity-0", "pointer-events-none")
      document.documentElement.classList.remove("overflow-hidden")
    }

    btn.addEventListener("click", () => {
      const isOpen = btn.classList.contains("open")
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    menu.addEventListener("click", e => {
      const el = e.target
      if (el instanceof HTMLElement && el.tagName === "A") {
        closeMenu()
      }
    })
  })
</script>

<style>
  #site-header .header-logo {
    transition: filter 0.3s ease;
  }

  #site-header:not(.header-solid) .header-logo {
    filter: invert(1);
  }

  #site-header.header-solid .header-logo {
    filter: none;
  }

  #site-header:not(.header-solid) .bar {
    background-color: white;
  }

  #site-header.header-solid .bar {
    background-color: black;
  }

  #menu-toggle.open .bar {
    background-color: black !important;
  }

  #menu-toggle.open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #menu-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }

  #menu-toggle.open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .bar {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease,
      background-color 0.3s ease;
  }
</style>
